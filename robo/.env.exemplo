# Copie este arquivo para ".env" (na mesma pasta do docker-compose.yml da VPS) e preencha.
# NUNCA coloque o .env no GitHub.

# Mesma URL do Web App (Apps Script) da planilha e a mesma senha (TOKEN_ROBO) do Apps Script
ROBO_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
ROBO_TOKEN=troque-por-uma-senha

# Login do PAE (usuario e senha) usado pelo robo no servidor
PAE_USUARIO=
PAE_SENHA=

# Opcional
ROBO_EMAIL_RELATORIO=seu-email@exemplo.com
ROBO_HORARIOS=07:30,12:30,17:30
