rules_version = '2';

// Regras do Sistema de Controle de Processos — CBMPA
//
// Deploy (requer Firebase CLI autenticado):
//   firebase deploy --only firestore:rules
//
// Modelo: todo usuário autenticado e ATIVO enxerga os dados operacionais;
// a coleção `usuarios` (aprovação de acesso e mudança de perfil) é restrita
// ao perfil `master`, com uma exceção controlada para autocadastro.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfilDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ativo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilDoc().ativo == true;
    }

    function master() {
      return ativo() && perfilDoc().perfil == 'master';
    }

    // Fiscal titular ou suplente do contrato informado (por e-mail).
    function fiscalDoContrato(contratoId) {
      return exists(/databases/$(database)/documents/contratos/$(contratoId))
        && (
          get(/databases/$(database)/documents/contratos/$(contratoId)).data.fiscalEmail
            == request.auth.token.email
          || get(/databases/$(database)/documents/contratos/$(contratoId)).data.fiscalSuplenteEmail
            == request.auth.token.email
        );
    }

    match /usuarios/{usuarioId} {
      // Qualquer usuário autenticado lê a lista (nomes/fiscais aparecem nas telas);
      // o próprio usuário sempre consegue ler seu documento para saber se foi aprovado.
      allow read: if autenticado();

      // Autocadastro ("Solicitar acesso"): só o próprio UID, sempre inativo e
      // sem se autopromover a master.
      allow create: if autenticado()
        && request.auth.uid == usuarioId
        && request.resource.data.ativo == false
        && request.resource.data.perfil != 'master'
        && !('senha' in request.resource.data);

      // Master cria (cadastro manual), aprova, muda perfil e remove.
      allow create, update: if master() && !('senha' in request.resource.data);
      allow delete: if master();

      // O próprio usuário pode ajustar dados de contato, nunca perfil/ativo.
      allow update: if autenticado()
        && request.auth.uid == usuarioId
        && request.resource.data.perfil == resource.data.perfil
        && request.resource.data.ativo == resource.data.ativo
        && !('senha' in request.resource.data);
    }

    // Índice público mínimo MF -> e-mail, pra permitir login por matrícula
    // (ver AppContext.tsx `login`/`solicitarAcesso`). "Primeiro a
    // registrar" (create) e imutável depois — nem o próprio usuário nem um
    // admin conseguem sobrescrever uma matrícula já vinculada a outra
    // conta; só quem está autenticado com aquele e-mail pode reivindicá-la.
    match /matriculas/{matricula} {
      allow read: if true;
      allow create: if autenticado()
        && request.auth.token.email == request.resource.data.email
        && request.resource.data.keys().hasOnly(['email']);
      allow update, delete: if false;
    }

    // Demais coleções operacionais: leitura para usuários ativos; escrita para
    // todos os ativos exceto os perfis de Diretoria (DGA, DAL, DF, DCA, BM4),
    // que são só consulta (o BM4 edita apenas IRPs e PCA, mais abaixo).
    match /processos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /movimentacoes/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /estadas_processo/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /pcas/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'bm4'];
    }
    match /alertas/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /pareceres/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /contratos/{documento} {
      allow read: if ativo();
      allow create, update: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
      // Só o master exclui contrato (ex.: cadastro em duplicidade).
      allow delete: if master();
      // O Fiscal titular/suplente pode ter o saldo do próprio contrato
      // atualizado automaticamente ao lançar uma execução (NF) — só os
      // campos de saldo, nunca os demais dados do contrato.
      allow update: if ativo()
        && perfilDoc().perfil == 'fiscal'
        && (resource.data.fiscalEmail == request.auth.token.email
          || resource.data.fiscalSuplenteEmail == request.auth.token.email)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saldoAtualFinanceiro', 'saldoAtualQuantitativo', 'atualizado_em']);
      // O Financeiro abate (ou devolve) o saldo financeiro do contrato ao
      // registrar o pagamento da fatura — só esse campo, nunca os demais.
      allow update: if ativo()
        && perfilDoc().perfil == 'financeiro'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saldoAtualFinanceiro', 'atualizado_em']);
    }
    match /execucoes/{documento} {
      allow read: if ativo();
      allow write: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
      // O Fiscal titular/suplente do contrato pode lançar execuções (NFs)
      // para o próprio contrato; sem edição/exclusão.
      allow create: if ativo()
        && perfilDoc().perfil == 'fiscal'
        && fiscalDoContrato(request.resource.data.contratoId);
    }
    match /ocorrencias/{documento} {
      allow read: if ativo();
      allow write: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
      // O Fiscal titular/suplente do contrato pode registrar qualquer tipo
      // de ocorrência para esse contrato; sem edição/exclusão.
      allow create: if ativo()
        && perfilDoc().perfil == 'fiscal'
        && fiscalDoContrato(request.resource.data.contratoId);
    }
    match /aditivos/{documento} {
      allow read: if ativo();
      allow write: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
    }
    match /procedimentos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos'];
      // Efeito colateral automático de uma IRP virando "aderida" (inclusive
      // quando quem responde é o Demandante — ver `updateIrp`,
      // AppContext.tsx): cria o procedimento de Adesão correspondente, sem
      // liberar edição/exclusão geral pro perfil demandante.
      allow create: if ativo()
        && perfilDoc().perfil == 'demandante'
        && request.resource.data.modalidade == 'Adesão'
        && request.resource.data.fase == 'Pendente';
    }
    match /sancionatorios/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos'];
    }
    match /portarias/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos'];
    }
    match /irps/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'bm4'];
      // O usuário Demandante do setor direcionado pode responder a IRP
      // (manifestar interesse/aderir) — só os campos de resposta, nunca os
      // campos de cadastro (esfera, órgão, número, objeto, prazos etc.).
      allow update: if ativo()
        && perfilDoc().perfil == 'demandante'
        && perfilDoc().unidadeDemandante in resource.data.setoresDemandantes
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'observacaoResposta', 'responsavelRespostaNome', 'responsavelRespostaEmail', 'procedimentoVinculadoId', 'atualizado_em']);
    }
    // "Turno" da sincronização automática com as planilhas (quem grava
    // `ultimaExecucao` primeiro assume a rodada — ver
    // src/hooks/useSincronizacaoAutomatica.ts). Só os perfis que já podem
    // sincronizar manualmente.
    match /sincronizacoes/{documento} {
      allow read, write: if ativo()
        && perfilDoc().perfil in ['master', 'apoio', 'contratos', 'gestao'];
    }
    match /notificacoes/{documento} {
      // Cada usuário só lê as próprias notificações (o cliente que dispara
      // o evento grava um doc por destinatário — ver
      // `dispararNotificacoesProcesso`, AppContext.tsx).
      allow read: if ativo() && resource.data.destinatarioId == request.auth.uid;
      allow create: if ativo();
      // Só marca como lida (nenhum outro campo pode mudar).
      allow update: if ativo()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      // O dono apaga as próprias notificações (lidas ou não).
      allow delete: if ativo() && resource.data.destinatarioId == request.auth.uid;
    }
    match /push_subscriptions/{documento} {
      // Leitura liberada a qualquer usuário ativo: quem dispara um evento
      // precisa localizar as inscrições dos destinatários pra repassar ao
      // /api/send-push — não são dados sensíveis (só endpoint/keys de
      // push), só o dono pode criar/alterar/remover a própria inscrição.
      allow read: if ativo();
      allow create, update: if ativo() && request.resource.data.usuarioId == request.auth.uid;
      allow delete: if ativo() && resource.data.usuarioId == request.auth.uid;
    }
    match /pagamentos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }
    match /empenhos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }
    // Catálogo código→descrição da classificação orçamentária (fonte, programa
    // de trabalho, natureza, plano interno, UG...). Quem preenche a dotação do
    // processo cadastra o código novo na hora; só master/financeiro apagam.
    // Itens incluídos/excluídos pelo master nos checklists dos ritos processuais.
    match /ajustes_rito/{documento} {
      allow read: if ativo();
      allow write: if master();
    }
    match /catalogo_orcamentario/{documento} {
      allow read: if ativo();
      allow create, update: if ativo()
        && perfilDoc().perfil in ['master', 'financeiro', 'apoio', 'contratos', 'gestao'];
      allow delete: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }
    match /dotacoes/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }

    // Índice mínimo e público de busca (número + objeto de processos,
    // número + empresa + objeto de contratos) — mantido só por um script
    // agendado (scripts/atualizar-busca-publica.mjs, via GitHub Actions),
    // que usa a conta de serviço e por isso ignora estas regras. Nenhum
    // cliente (nem autenticado) escreve aqui diretamente.
    match /busca_publica/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // Log de acesso (login bem-sucedido ou falho). Um login mal-sucedido
    // (senha incorreta, e-mail inexistente) acontece ANTES de qualquer
    // sessão válida — não há como exigir autenticação para essa escrita
    // sem impedir justamente o registro das falhas, que é o caso mais
    // importante para auditoria de segurança. Por isso a criação fica
    // aberta, restrita ao formato mínimo esperado; leitura só para master.
    match /logs_acesso/{documento} {
      allow read: if master();
      allow create: if request.resource.data.email is string
        && request.resource.data.sucesso is bool
        && request.resource.data.keys().hasOnly(['userId', 'email', 'sucesso', 'dataHora', 'userAgent']);
      allow update, delete: if false;
    }

    // Log de auditoria de dados: qualquer usuário autenticado grava (o
    // próprio sistema registra em nome de quem fez a ação, sempre como
    // efeito colateral de uma ação já autorizada na coleção de origem);
    // leitura só para master; sem edição/exclusão (trilha imutável).
    match /logs_auditoria/{documento} {
      allow read: if master();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // Nada mais é acessível.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
