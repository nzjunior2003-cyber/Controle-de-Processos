rules_version = '2';

// Regras do Sistema de Controle de Processos — CBMPA
//
// Deploy (requer Firebase CLI autenticado):
//   firebase deploy --only firestore:rules
//
// Modelo: todo usuário autenticado e ATIVO enxerga os dados operacionais;
// a coleção `usuarios` (aprovação de acesso e mudança de perfil) é restrita
// ao perfil `master`, com uma exceção controlada para autocadastro.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfilDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ativo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilDoc().ativo == true;
    }

    function master() {
      return ativo() && perfilDoc().perfil == 'master';
    }

    // Fiscal titular ou suplente do contrato informado (por e-mail).
    function fiscalDoContrato(contratoId) {
      return exists(/databases/$(database)/documents/contratos/$(contratoId))
        && (
          get(/databases/$(database)/documents/contratos/$(contratoId)).data.fiscalEmail
            == request.auth.token.email
          || get(/databases/$(database)/documents/contratos/$(contratoId)).data.fiscalSuplenteEmail
            == request.auth.token.email
        );
    }

    match /usuarios/{usuarioId} {
      // Qualquer usuário autenticado lê a lista (nomes/fiscais aparecem nas telas);
      // o próprio usuário sempre consegue ler seu documento para saber se foi aprovado.
      // [a confirmar] Restringir a leitura (ver SEGURANCA.md) fica para depois, com aviso.
      allow read: if autenticado();

      // Autocadastro ("Solicitar acesso"): só o próprio UID, sempre INATIVO,
      // sempre perfil `fiscal` (o master muda o perfil ao aprovar), com o
      // e-mail da própria conta e só os campos do formulário.
      allow create: if autenticado()
        && request.auth.uid == usuarioId
        && request.resource.data.ativo == false
        && request.resource.data.perfil == 'fiscal'
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['nome', 'email', 'cargo', 'perfil', 'setor_id', 'ativo', 'mf', 'nomeGuerra', 'ubm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 200;

      // Master cria (cadastro manual), aprova, muda perfil e remove.
      allow create, update: if master() && !('senha' in request.resource.data);
      allow delete: if master();

      // O próprio usuário ajusta só dados de contato — nunca perfil, ativo,
      // e-mail, MF nem unidade demandante (isso é papel do master).
      allow update: if autenticado()
        && request.auth.uid == usuarioId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'cargo', 'nomeGuerra', 'ubm']);
    }

    // Índice público mínimo MF -> e-mail, pra permitir login por matrícula
    // (ver AppContext.tsx `login`/`solicitarAcesso`). "Primeiro a
    // registrar" (create) e imutável depois — nem o próprio usuário nem um
    // admin conseguem sobrescrever uma matrícula já vinculada a outra
    // conta; só quem está autenticado com aquele e-mail pode reivindicá-la.
    match /matriculas/{matricula} {
      // Só consulta pontual (get) — o login por matrícula precisa dela antes
      // de autenticar; listar todas as matrículas/e-mails fica proibido.
      allow get: if true;
      allow list: if false;
      allow create: if autenticado()
        && request.auth.token.email == request.resource.data.email
        && request.resource.data.keys().hasOnly(['email']);
      allow update, delete: if false;
    }

    // Demais coleções operacionais: leitura para usuários ativos; escrita para
    // todos os ativos exceto os perfis de Diretoria (DGA, DAL, DF, DCA, BM4),
    // que são só consulta (o BM4 edita apenas IRPs e PCA, mais abaixo).
    // Campos do fluxo oficial de compras (etapa atual, rito do fluxo e decisões).
    // Só master, apoio e contratos alteram; a confirmação carrega o uid de quem
    // confirmou (não dá para forjar) e os valores são validados.
    function camposFluxo() {
      return ['etapaAtualId', 'etapaOrigem', 'etapaConfirmadaEm', 'etapaConfirmadaPor', 'ritoProcessual',
        'dispensaAteMetadeLimite', 'necessitaDotacao', 'cbmGerenciadorOuParticipeArp',
        'parecerJuridicoAprovadoSemRecomendacoes', 'haveraFaseExterna'];
    }
    function perfilFluxo() {
      return perfilDoc().perfil in ['master', 'apoio', 'contratos'];
    }
    function fluxoValido(d) {
      return (!('etapaAtualId' in d) || (d.etapaAtualId is string && d.etapaAtualId.matches('^E(0[1-9]|[12][0-9]|3[0-5])$')))
        && (!('etapaOrigem' in d) || d.etapaOrigem in ['auto', 'manual'])
        && (!('ritoProcessual' in d) || d.ritoProcessual in ['pregao_srp', 'pregao', 'concorrencia', 'dispensa_eletronica', 'inexigibilidade', 'gerenciador_ata', 'participe_ata', 'adesao_ata'])
        && (!('dispensaAteMetadeLimite' in d) || d.dispensaAteMetadeLimite is bool)
        && (!('necessitaDotacao' in d) || d.necessitaDotacao is bool)
        && (!('cbmGerenciadorOuParticipeArp' in d) || d.cbmGerenciadorOuParticipeArp is bool)
        && (!('parecerJuridicoAprovadoSemRecomendacoes' in d) || d.parecerJuridicoAprovadoSemRecomendacoes is bool)
        && (!('haveraFaseExterna' in d) || d.haveraFaseExterna is bool);
    }
    // Atualização: se mexe em algum campo do fluxo, perfil permitido + valores válidos
    // + (ao mudar a etapa) confirmação em nome de quem está logado.
    function atualizacaoFluxoOk() {
      let mudou = request.resource.data.diff(resource.data).affectedKeys();
      return !mudou.hasAny(camposFluxo())
        || (perfilFluxo()
          && fluxoValido(request.resource.data)
          && (!mudou.hasAny(['etapaConfirmadaPor']) || request.resource.data.etapaConfirmadaPor == request.auth.uid)
          && (!mudou.hasAny(['etapaAtualId'])
            || (mudou.hasAny(['etapaConfirmadaEm']) && request.resource.data.get('etapaConfirmadaPor', '') == request.auth.uid)));
    }
    function criacaoFluxoOk() {
      return !request.resource.data.keys().hasAny(camposFluxo())
        || (perfilFluxo() && fluxoValido(request.resource.data));
    }

    // Processos: exclusão LÓGICA (campos `excluido*`), só pelos perfis
    // administrativos; apagar de vez (delete) só o master.
    match /processos/{documento} {
      allow read: if ativo();
      allow create: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4'])
        && criacaoFluxoOk();
      allow update: if ativo()
        && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4'])
        && (
          request.resource.data.get('excluido', false) == resource.data.get('excluido', false)
          || perfilDoc().perfil in ['master', 'contratos', 'apoio']
        )
        && atualizacaoFluxoOk();
      allow delete: if master();
    }
    match /movimentacoes/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /estadas_processo/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /pcas/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'bm4'];
    }
    match /alertas/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /pareceres/{documento} {
      allow read: if ativo();
      allow write: if ativo() && !(perfilDoc().perfil in ['dga', 'dal', 'df', 'dca', 'bm4']);
    }
    match /contratos/{documento} {
      allow read: if ativo();
      allow create, update: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
      // Só o master exclui contrato (ex.: cadastro em duplicidade).
      allow delete: if master();
      // O Fiscal titular/suplente pode ter o saldo do próprio contrato
      // atualizado automaticamente ao lançar uma execução (NF) — só os
      // campos de saldo, nunca os demais dados do contrato.
      allow update: if ativo()
        && perfilDoc().perfil == 'fiscal'
        && (resource.data.fiscalEmail == request.auth.token.email
          || resource.data.fiscalSuplenteEmail == request.auth.token.email)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saldoAtualFinanceiro', 'saldoAtualQuantitativo', 'atualizado_em']);
      // O Financeiro abate (ou devolve) o saldo financeiro do contrato ao
      // registrar o pagamento da fatura, e informa a dotação orçamentária quando ela
      // ainda não veio do Apoio e Suprimento — só esses campos, nunca os demais.
      allow update: if ativo()
        && perfilDoc().perfil == 'financeiro'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saldoAtualFinanceiro', 'dotacoes_orcamentarias', 'atualizado_em']);
    }
    match /execucoes/{documento} {
      allow read: if ativo();
      allow write: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
      // O Fiscal titular/suplente do contrato pode lançar execuções (NFs)
      // para o próprio contrato; sem edição/exclusão.
      allow create: if ativo()
        && perfilDoc().perfil == 'fiscal'
        && fiscalDoContrato(request.resource.data.contratoId);
    }
    match /ocorrencias/{documento} {
      allow read: if ativo();
      allow write: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
      // O Fiscal titular/suplente do contrato pode registrar qualquer tipo
      // de ocorrência para esse contrato; sem edição/exclusão.
      allow create: if ativo()
        && perfilDoc().perfil == 'fiscal'
        && fiscalDoContrato(request.resource.data.contratoId);
    }
    match /aditivos/{documento} {
      allow read: if ativo();
      allow write: if ativo()
        && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
    }
    match /procedimentos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos'];
      // Efeito colateral automático de uma IRP virando "aderida" (inclusive
      // quando quem responde é o Demandante — ver `updateIrp`,
      // AppContext.tsx): cria o procedimento de Adesão correspondente, sem
      // liberar edição/exclusão geral pro perfil demandante.
      allow create: if ativo()
        && perfilDoc().perfil == 'demandante'
        && request.resource.data.modalidade == 'Adesão'
        && request.resource.data.fase == 'Pendente';
    }
    match /sancionatorios/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos'];
    }
    match /portarias/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos'];
    }
    match /irps/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'bm4'];
      // O usuário Demandante do setor direcionado pode responder a IRP
      // (manifestar interesse/aderir) — só os campos de resposta, nunca os
      // campos de cadastro (esfera, órgão, número, objeto, prazos etc.).
      allow update: if ativo()
        && perfilDoc().perfil == 'demandante'
        && perfilDoc().unidadeDemandante in resource.data.setoresDemandantes
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'observacaoResposta', 'responsavelRespostaNome', 'responsavelRespostaEmail', 'procedimentoVinculadoId', 'atualizado_em']);
    }
    // "Turno" da sincronização automática com as planilhas (quem grava
    // `ultimaExecucao` primeiro assume a rodada — ver
    // src/hooks/useSincronizacaoAutomatica.ts). Só os perfis que já podem
    // sincronizar manualmente.
    match /sincronizacoes/{documento} {
      allow read, write: if ativo()
        && perfilDoc().perfil in ['master', 'apoio', 'contratos', 'gestao'];
    }
    match /notificacoes/{documento} {
      // Cada usuário só lê as próprias notificações (o cliente que dispara
      // o evento grava um doc por destinatário — ver
      // `dispararNotificacoesProcesso`, AppContext.tsx).
      allow read: if ativo() && resource.data.destinatarioId == request.auth.uid;
      allow create: if ativo()
        && request.resource.data.destinatarioId is string
        && request.resource.data.destinatarioId.size() <= 128;
      // Só marca como lida (nenhum outro campo pode mudar).
      allow update: if ativo()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      // O dono apaga as próprias notificações (lidas ou não).
      allow delete: if ativo() && resource.data.destinatarioId == request.auth.uid;
    }
    match /push_subscriptions/{documento} {
      // Leitura liberada a qualquer usuário ativo: quem dispara um evento
      // precisa localizar as inscrições dos destinatários pra repassar ao
      // /api/send-push — não são dados sensíveis (só endpoint/keys de
      // push), só o dono pode criar/alterar/remover a própria inscrição.
      allow read: if ativo();
      allow create, update: if ativo() && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.matches('^https://.*');
      allow delete: if ativo() && resource.data.usuarioId == request.auth.uid;
    }
    match /pagamentos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }
    match /empenhos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }
    // Catálogo código→descrição da classificação orçamentária (fonte, programa
    // de trabalho, natureza, plano interno, UG...). Quem preenche a dotação do
    // processo cadastra o código novo na hora; só master/financeiro apagam.
    // Aditivos de ARP/ata (prorrogação de vigência) e apostilamentos de contrato.
    match /aditivos_arp/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos'];
    }
    match /apostilamentos/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'contratos', 'gestao'];
    }
    // Prazos do fluxo de compras (Fase C): todo usuário ativo lê; só o Master e o
    // perfil DAL gravam, em um único documento (`prazos`), com chaves e números válidos.
    function numeroOk(mapa, chave) {
      return !(chave in mapa) || (mapa[chave] is number && mapa[chave] >= 0 && mapa[chave] <= 365);
    }
    function configPrazosValida(d) {
      return d.keys().hasOnly(['diasPorEtapa', 'prazoAteContratoPorRito', 'atualizado_em', 'atualizado_por'])
        && (!('diasPorEtapa' in d) || (d.diasPorEtapa is map
          && d.diasPorEtapa.keys().hasOnly(['E01', 'E02', 'E03', 'E04', 'E05', 'E06', 'E07', 'E08', 'E09', 'E10', 'E11', 'E12', 'E13', 'E14', 'E15', 'E16', 'E17', 'E18', 'E19', 'E20', 'E21', 'E22', 'E23', 'E24', 'E25', 'E26', 'E27', 'E28', 'E29', 'E30', 'E31', 'E32', 'E33', 'E34', 'E35'])
          && numeroOk(d.diasPorEtapa, 'E01')
        && numeroOk(d.diasPorEtapa, 'E02')
        && numeroOk(d.diasPorEtapa, 'E03')
        && numeroOk(d.diasPorEtapa, 'E04')
        && numeroOk(d.diasPorEtapa, 'E05')
        && numeroOk(d.diasPorEtapa, 'E06')
        && numeroOk(d.diasPorEtapa, 'E07')
        && numeroOk(d.diasPorEtapa, 'E08')
        && numeroOk(d.diasPorEtapa, 'E09')
        && numeroOk(d.diasPorEtapa, 'E10')
        && numeroOk(d.diasPorEtapa, 'E11')
        && numeroOk(d.diasPorEtapa, 'E12')
        && numeroOk(d.diasPorEtapa, 'E13')
        && numeroOk(d.diasPorEtapa, 'E14')
        && numeroOk(d.diasPorEtapa, 'E15')
        && numeroOk(d.diasPorEtapa, 'E16')
        && numeroOk(d.diasPorEtapa, 'E17')
        && numeroOk(d.diasPorEtapa, 'E18')
        && numeroOk(d.diasPorEtapa, 'E19')
        && numeroOk(d.diasPorEtapa, 'E20')
        && numeroOk(d.diasPorEtapa, 'E21')
        && numeroOk(d.diasPorEtapa, 'E22')
        && numeroOk(d.diasPorEtapa, 'E23')
        && numeroOk(d.diasPorEtapa, 'E24')
        && numeroOk(d.diasPorEtapa, 'E25')
        && numeroOk(d.diasPorEtapa, 'E26')
        && numeroOk(d.diasPorEtapa, 'E27')
        && numeroOk(d.diasPorEtapa, 'E28')
        && numeroOk(d.diasPorEtapa, 'E29')
        && numeroOk(d.diasPorEtapa, 'E30')
        && numeroOk(d.diasPorEtapa, 'E31')
        && numeroOk(d.diasPorEtapa, 'E32')
        && numeroOk(d.diasPorEtapa, 'E33')
        && numeroOk(d.diasPorEtapa, 'E34')
        && numeroOk(d.diasPorEtapa, 'E35')))
        && (!('prazoAteContratoPorRito' in d) || (d.prazoAteContratoPorRito is map
          && d.prazoAteContratoPorRito.keys().hasOnly(['pregao_srp', 'pregao', 'concorrencia', 'dispensa_eletronica', 'inexigibilidade', 'gerenciador_ata', 'participe_ata', 'adesao_ata'])
          && numeroOk(d.prazoAteContratoPorRito, 'pregao_srp')
        && numeroOk(d.prazoAteContratoPorRito, 'pregao')
        && numeroOk(d.prazoAteContratoPorRito, 'concorrencia')
        && numeroOk(d.prazoAteContratoPorRito, 'dispensa_eletronica')
        && numeroOk(d.prazoAteContratoPorRito, 'inexigibilidade')
        && numeroOk(d.prazoAteContratoPorRito, 'gerenciador_ata')
        && numeroOk(d.prazoAteContratoPorRito, 'participe_ata')
        && numeroOk(d.prazoAteContratoPorRito, 'adesao_ata')))
        && (!('atualizado_por' in d) || d.atualizado_por == request.auth.uid);
    }
    match /config_fluxo/{documento} {
      allow read: if ativo();
      allow create, update: if ativo()
        && documento == 'prazos'
        && perfilDoc().perfil in ['master', 'dal']
        && configPrazosValida(request.resource.data);
      allow delete: if master();
    }

    // Itens incluídos/excluídos pelo master nos checklists dos ritos processuais.
    match /ajustes_rito/{documento} {
      allow read: if ativo();
      allow write: if master();
    }
    match /catalogo_orcamentario/{documento} {
      allow read: if ativo();
      allow create, update: if ativo()
        && perfilDoc().perfil in ['master', 'financeiro', 'apoio', 'contratos', 'gestao'];
      allow delete: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }
    match /dotacoes/{documento} {
      allow read: if ativo();
      allow write: if ativo() && perfilDoc().perfil in ['master', 'financeiro'];
    }

    // Índice mínimo e público de busca (número + objeto de processos,
    // número + empresa + objeto de contratos) — mantido só por um script
    // agendado (scripts/atualizar-busca-publica.mjs, via GitHub Actions),
    // que usa a conta de serviço e por isso ignora estas regras. Nenhum
    // cliente (nem autenticado) escreve aqui diretamente.
    match /busca_publica/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // Log de acesso (login bem-sucedido ou falho). Um login mal-sucedido
    // (senha incorreta, e-mail inexistente) acontece ANTES de qualquer
    // sessão válida — não há como exigir autenticação para essa escrita
    // sem impedir justamente o registro das falhas, que é o caso mais
    // importante para auditoria de segurança. Por isso a criação fica
    // aberta, restrita ao formato mínimo esperado; leitura só para master.
    match /logs_acesso/{documento} {
      allow read: if master();
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 400))
        && request.resource.data.sucesso is bool
        && request.resource.data.keys().hasOnly(['userId', 'email', 'sucesso', 'dataHora', 'userAgent']);
      allow update, delete: if false;
    }

    // Log de auditoria de dados: qualquer usuário autenticado grava (o
    // próprio sistema registra em nome de quem fez a ação, sempre como
    // efeito colateral de uma ação já autorizada na coleção de origem);
    // leitura só para master; sem edição/exclusão (trilha imutável).
    match /logs_auditoria/{documento} {
      allow read: if master();
      // Só usuário ATIVO e só em nome de si mesmo (não dá pra forjar autoria).
      allow create: if ativo()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.keys().hasAll(['colecao', 'acao', 'usuarioId']);
      allow update, delete: if false;
    }

    // Nada mais é acessível.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
