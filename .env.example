# ---------------------------------------------------------------------------
# Firebase (obrigatório) — Console > Configurações do projeto > Seus apps > Web
# Sem estas variáveis o app abre, mas o login e a persistência ficam desligados.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# SMTP (opcional) — usado apenas pelo endpoint /api/send-email, que dispara os
# alertas automáticos de contrato aos fiscais (src/components/AlertasModal.tsx).
# Sem estas variáveis o envio é apenas simulado (log no servidor).
# A recuperação de senha NÃO usa SMTP: é feita pelo Firebase Authentication.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu_email_da_secao@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_do_google
SMTP_FROM=Sistema CBMPA <seu_email_da_secao@gmail.com>

# ---------------------------------------------------------------------------
# Push (Web Push/VAPID, opcional) — usado pelo endpoint /api/send-push, que
# dispara as notificações push de mudança de setor/fase/conclusão de processo
# (ver dispararNotificacoesProcesso em src/context/AppContext.tsx). Gere o par
# de chaves uma única vez com `npx web-push generate-vapid-keys` e use o MESMO
# par nas três variáveis abaixo (a pública se repete, uma pro servidor e outra
# embutida no build do front). Sem estas variáveis o push simplesmente não sai
# (o resto do sistema — inclusive a central de notificações — continua
# funcionando normalmente).
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
